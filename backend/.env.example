AI_RUNTIME_MODE=demo
DATABASE_PATH=data/mountainlore.db
MEDIA_DIRECTORY=data/media

# Set AI_RUNTIME_MODE=live and supply your Credits key(s) to use real providers.
OPENAI_NEXT_BASE_URL=https://api.openai-next.com/v1
OPENAI_NEXT_API_KEY=your_credits_api_key
OPENAI_NEXT_TEXT_MODEL=gpt-5.5
# Require OpenAI-compatible JSON mode for synchronous text generation. Set to
# false only when a compatible gateway explicitly rejects response_format.
OPENAI_NEXT_JSON_MODE=true
OPENAI_NEXT_TIDE_MODEL=sonar

# The weekly Tide report has an isolated provider path. It does not affect the
# models used by fieldwork, brand direction, or generation.
TIDE_API_BASE_URL=https://api.openai-next.com/v1
TIDE_API_KEY=your_credits_api_key
# 联网检索模型；需要与 TIDE_API_KEY 对应的服务权限。
TIDE_SEARCH_MODEL=sonar-medium-online
TIDE_SYNTHESIS_MODEL=kimi-k3
TIDE_SEARCH_PROVIDER=tavily
# AI_RUNTIME_MODE=live 时必填；请在此填写 Tavily 的 API Key。
TAVILY_API_KEY=your_tavily_api_key
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS_PER_QUERY=3
TAVILY_COUNTRY=china
TIDE_SEARCH_LOOKBACK_DAYS=30

# 图片生成通道,默认指向 StepFun 生图大模型(OpenAI 兼容);填入 StepFun 平台的 API Key。
# 尺寸为 StepFun 竖版 3:4;若换回其他兼容网关,需确保 size 与模型受其支持。
OPENAI_NEXT_IMAGE_BASE_URL=https://api.stepfun.com/v1
OPENAI_NEXT_IMAGE_API_KEY=your_stepfun_api_key
OPENAI_NEXT_IMAGE_MODEL=step-image-edit-2
OPENAI_NEXT_IMAGE_SIZE=896x1184
PROVIDER_TIMEOUT_SECONDS=120
# 定调不应被远端文字模型长时间阻塞；超时后会使用冻结事实生成三条可选路线。
ROUTE_GENERATION_TIMEOUT_SECONDS=20
TIDE_REFRESH_INTERVAL_SECONDS=60
TIDE_SOURCE_VERIFY_TIMEOUT_SECONDS=12
TIDE_SOURCE_MAX_RESULTS=30
