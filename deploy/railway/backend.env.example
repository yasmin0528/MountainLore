# Railway backend service variables. Keep provider keys in Railway's sealed
# variables UI, never commit them to this file.
ENVIRONMENT=production
DEBUG=false
DATABASE_PATH=/app/data/mountainlore.db
MEDIA_DIRECTORY=/app/data/media

# Use demo mode for a public smoke test. Change to live only after adding
# the provider keys below in Railway.
AI_RUNTIME_MODE=demo

# Only needed if the FastAPI service is deliberately exposed publicly.
# With the recommended private backend, browser traffic reaches it through
# the frontend's same-origin /api proxy.
CORS_ORIGINS=https://YOUR-FRONTEND.up.railway.app

# Set these as sealed variables when AI_RUNTIME_MODE=live:
# OPENAI_NEXT_API_KEY=
# TIDE_API_KEY=
# TAVILY_API_KEY=
# OPENAI_NEXT_IMAGE_API_KEY=
